	lights true
	clipboard_read false
	clipboard_write false

$bog_dock_side $mol_view
	mode \none
	opened? false
	attr *
		^
		bog_dock_side_mode <= mode
		bog_dock_side_opened <= opened
	sub /
		<= Shade $mol_view
			event *
				click? <=> close? null
		<= Frame $bog_dock_frame
			lights <= lights true
		<= Tab $mol_view
			dom_name \button
			attr *
				^
				type \button
				title <= tab_hint @ \Apps
				aria-label <= tab_hint
				aria-expanded <= tab_expanded \false
			event *
				pointerdown? <=> tab_grab? null
				pointermove? <=> tab_move? null
				click? <=> tab_click? null
