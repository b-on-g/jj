		<= Copy $mol_button_copy
			hint @ \Copy whole code
			text <= text_export \

$mol_textarea $mol_stack
	attr *
		^
		mol_textarea_clickable <= clickable? false
		mol_textarea_sidebar_showed <= sidebar_showed false
	event *
		keydown? <=> press? null
		pointermove? <=> hover? null
	sub /
		<= Edit $mol_textarea_edit
			value? <=> value? \
			hint <= hint \ 
			enabled <= enabled true
			spellcheck <= spellcheck true
			length_max <= length_max +Infinity
			selection? <=> selection? /number
			bring => bring
			submit? <=> submit? null
			submit_with_ctrl <= submit_with_ctrl true
		<= View $mol_text_code
			text <= value
			render_visible_only false
			row_numb* <= row_numb* 0
			sidebar_showed <= sidebar_showed
			highlight <= highlight \
			syntax <= syntax $mol_syntax2
	symbols_alt *string
		comma \<
		period \>
		dash \−
		equals \≈
		graveAccent \́
		forwardSlash \÷
		E \€
		V \✔
		X \×
		C \©
		P \§
		H \₽
		key0 \°
		key8 \•
		key2 \@
		key3 \#
		key4 \$
		key6 \^
		key7 \&
		bracketOpen \[
		bracketClose \]
		slashBack \|
	symbols_alt_ctrl *string
		space \ 
	symbols_alt_shift *string
		V \✅
		X \❌
		O \⭕
		key1 \❗
		key4 \💲
		key7 \❓
		comma \«
		period \»
		semicolon \“
		quoteSingle \”
		dash \—
		equals \≠
		graveAccent \̱
		bracketOpen \{
		bracketClose \}

$mol_textarea_edit $mol_string
	dom_name \textarea
	enter \enter
	field *
		^
		scrollTop 0

$bog_jj_post $mol_page
	post_link \
	blog_link \
	Editable true
	title @ \Post
	Untitled @ \Untitled
	Published_on @ \Published
	Published_off @ \Draft
	Save_hint @ \Edit
	Publish_hint @ \Publish
	Unpublish_hint @ \To draft
	Delete_hint @ \Delete post
	Delete_confirm @ \Delete this post forever?
	Delete_yes @ \Delete
	Delete_no @ \Cancel
	Cover_add @ \Cover
	Cover_drop @ \Remove cover
	Author_link @ \All author posts
	Comments_title @ \Comments
	Comment_hint @ \Your comment
	Comment_send @ \Send
	Comment_reply @ \Reply
	Comment_drop @ \Delete
	Comment_cancel_hint @ \Cancel
	Like_hint @ \Like
	Comments_empty @ \Nobody has commented yet
	head /
		<= Back $mol_link
			arg *
				post null
				blog <= blog_link
				tag null
			hint @ \To blog
			sub / <= Back_icon $mol_icon_arrow_left
		<= Title
		<= Tools
	tools /
		<= Tools_content $mol_row
			sub <= tools_rows /
				<= Edit_toggle $mol_check_icon
					hint <= Save_hint
					checked? <=> editing? false
					Icon <= Edit_icon $mol_icon_pencil
				<= Publish $mol_button_minor
					hint <= Publish_hint
					click? <=> publish? null
					sub / <= Publish_icon $mol_icon_send
				<= Delete $mol_pop
					showed? <=> delete_asked? false
					Anchor <= Delete_anchor $mol_button_minor
						hint <= Delete_hint
						click? <=> delete_ask? null
						sub / <= Delete_icon $mol_icon_close
					bubble_content /
						<= Delete_question $mol_paragraph
							title <= Delete_confirm
						<= Delete_actions $mol_row
							sub /
								<= Delete_no_button $mol_button_minor
									title <= Delete_no
									click? <=> delete_cancel? null
								<= Delete_yes_button $mol_button_major
									title <= Delete_yes
									click? <=> delete? null
	body /
		<= Article $mol_list
			rows <= article_rows /
				<= Cover $mol_view
					style <= cover_box_style *
					sub / <= Cover_image $mol_view
						style <= cover_style *
				<= Post_head $mol_view
					sub /
						<= Author $mol_link
							arg *
								blog <= blog_link
								post null
								tag null
							hint <= Author_link
							sub /
								<= Author_avatar $mol_view
									style <= author_avatar_style *
								<= Author_name $mol_link
									arg *
										blog <= blog_link
										post null
										tag null
									title <= blog_title \
						<= State $mol_paragraph
							title <= state_text \
						<= Date_text $mol_paragraph
							title <= date_text \
				<= Title_field $mol_string
					hint <= Untitled
					value? <=> post_title? \
				<= Title_text $mol_view
					sub / <= post_title_text \
				<= Tags $mol_select_list
					value? <=> tags? /string
					dictionary <= tag_dictionary *
				<= Tags_text $mol_view
					sub <= tag_links /
				<= Body_editor $giper_baza_rich_edit
					pawn <= body_pawn null
					enabled <= is_editing false
					style <= body_editor_style *
				<= Actions $mol_row
					sub <= action_rows /
						<= Like_button $mol_button_minor
							hint <= Like_hint
							click? <=> like_toggle? null
							sub /
								<= Like_icon $mol_icon_heart
								<= Likes_text \
						<= Cover_pick $mol_button_open
							multiple false
							accept \image/*
							hint <= Cover_add
							sub /
								<= Cover_native $mol_button_open_native
									files? <=> cover_add? /File
									accept \image/*
									multiple false
								<= Cover_pick_icon $mol_icon_image
						<= Cover_remove $mol_button_minor
							hint <= Cover_drop
							click? <=> cover_drop? null
							sub / <= Cover_remove_icon $mol_icon_close
		<= Comments $mol_list
			rows <= comment_rows /
				<= Comments_head $mol_paragraph
					title <= Comments_title
				<= Comment_form $mol_view
					sub <= comment_form_rows /
						<= Comment_input $mol_textarea
							hint <= Comment_hint
							value? <=> comment_draft? \
						<= Comment_send_button $mol_button_major
							title <= Comment_send
							click? <=> comment_submit? null
						<= Comment_cancel $mol_button_minor
							title <= Comment_cancel_hint
							click? <=> comment_cancel? null
				<= Comments_empty_view $mol_paragraph
					title <= Comments_empty
				<= Comment* $mol_view
					sub /
						<= Comment_indent* $mol_view
							style <= comment_indent_style* *
						<= Comment_card* $mol_card
							sub /
								<= Comment_head* $mol_view
									sub /
										<= Comment_author* $mol_avatar
											id <= comment_author_link* \
										<= Comment_date* $mol_paragraph
											title <= comment_date* \
								<= Comment_text* $mol_paragraph
									title <= comment_text* \
								<= Comment_actions* $mol_row
									sub /
										<= Comment_reply_button* $mol_button_minor
											title <= Comment_reply
											click? <=> comment_reply*? null
										<= Comment_drop_button* $mol_button_minor
											title <= Comment_drop
											enabled <= comment_mine* false
											click? <=> comment_drop_action*? null
	Tag_link* $mol_link
		arg *
			tag <= tag_link_tag* \
			post null
			blog null
		title <= tag_link_title* \

$bog_jj_feed $mol_page
	title @ \Feed
	search \
	tag \
	My_blogs_title @ \My blogs
	Feed_title @ \Latest
	Empty_hint @ \Quiet for now. Create a blog or subscribe to someone else.
	Nothing_found @ \Nothing matches your search yet.
	Create_hint @ \Create blog
	head /
		<= Title
	body /
		<= My_blogs $mol_list
			rows /
				<= My_blogs_head $mol_paragraph
					title <= My_blogs_title
				<= My_blogs_list $mol_list
					rows <= my_blog_rows /
						<= My_blog* $mol_link
							arg *
								blog <= my_blog_link* \
								post null
								tag null
								settings null
							sub /
								<= My_blog_avatar* $mol_view
									style <= my_blog_avatar_style* *
								<= My_blog_title* $mol_view
									sub / <= my_blog_title* \
				<= Create_row $mol_row
					sub <= create_rows /
						<= Create $mol_button_major
							title <= Create_hint
							click? <=> create_toggle? null
						<= Create_form $mol_row
							sub /
								<= Create_input $mol_string
									hint @ \Blog name
									value? <=> create_title? \
									submit? <=> create? null
								<= Create_button $mol_button_major
									title <= Create_hint
									click? <=> create? null
		<= Tags $mol_view
			sub <= tag_links /
				<= Tag* $mol_link
					arg *
						tag <= tag_link* \
						post null
						blog null
					title <= tag_title* \
		<= Feed $mol_list
			rows <= feed_rows /
				<= Feed_head $mol_paragraph
					title <= Feed_title
				<= Cards $mol_list
					rows <= cards /
						<= Card* $bog_jj_card
							post_link <= card_post* \
							blog_link <= card_blog* \
							tag_select? <=> tag_select? null
				<= Empty $mol_paragraph
					title <= feed_empty \

$mol_section $mol_list
	level 1
	rows /
		<= Head $mol_view
			sub <= head /
				<= Title $mol_view
					dom_name <= title_dom_name \h1
					sub / <= title
				<= Tools $mol_view sub <= tools /
		<= Content $mol_list
			rows <= content /

$giper_baza_link_chip $mol_link
	param \link
	link $giper_baza_link
	sub /
		<= icon \
		<= title

$giper_baza_land_rights $mol_list
	land $giper_baza_land
	rows /
		<= Add $mol_view sub /
			<= Add_key $mol_string
				hint @ \Public key
				value? <=> add_key? \
				submit? <=> add_commit? null
				enabled <= enabled false
			<= Add_commit $mol_button_minor
				click? <=> add_commit? null
				enabled <= enabled false
				sub /
					<= Add_commit_icon $mol_icon_plus
		^ gifts /
			<= Gift*0 $mol_view sub /
				<= Gift_rate* $mol_select
					hint @ \Speed
					value? <=> gift_rate*? \0
					enabled <= enabled false
					Filter null
					dictionary *
						0 \0 🦼 ~1W
						1 \1 🚲 ~3D
						2 \2 🛵 ~1D
						3 \3 🚜 ~D/2
						4 \4 🏇 ~8h
						5 \5 🚂 ~4h
						6 \6 🚛 ~2h
						7 \7 🚗 ~1h
						8 \8 🏍️ ~h/2
						9 \9 🏎️ ~5m
						A \A 🚅 ~2m
						B \B 🚁 ~m/2
						C \C 🛩️ ~2s
						D \D ✈️ ~s/2
						E \E 🚀 ~50ms
						F \F 🛸 ~1ms
				<= Gift_tier* $mol_select
					hint @ \Level
					value? <=> gift_tier*? \deny
					Filter null
					dictionary <= tier_options *
						deny @ \🛑 Deny
						read @ \👀 Read
						post @ \✍ Post
						pull @ \🥂 Pull
						rule @ \👑 Rule
					enabled <= enabled false
				<= Gift_name* $giper_baza_link_chip
					param <= link_param \link
					link <= peer_link* $giper_baza_link
					sub /
						^
						<= Gift_avatar* $mol_avatar
							id <= peer_id* \

$bog_jj_settings $mol_page
	blog_link \
	title @ \Blog settings
	Avatar_title @ \Avatar
	Cover_title @ \Cover
	Cover_drop @ \Remove
	About_hint @ \About
	Title_hint @ \Blog name
	Socials_hint @ \Links separated by commas
	Access_title @ \Access
	Profile_title @ \Profile
	Pick @ \Upload
	Account_title @ \Your account
	Public_title @ \Public land
	Public_hint @ \Comments and likes live here. Share the link with readers: anyone can write.
	head /
		<= Back $mol_link
			arg *
				blog <= blog_link
				settings null
				post null
				tag null
			hint @ \To blog
			sub / <= Back_icon $mol_icon_arrow_left
		<= Title
	body /
		<= Profile_section $mol_section
			title <= Profile_title
			content /
				<= Title_field $mol_string
					hint <= Title_hint
					value? <=> blog_title? \
				<= About_field $mol_textarea
					hint <= About_hint
					value? <=> blog_about? \
				<= Socials_field $mol_textarea
					hint <= Socials_hint
					value? <=> socials_text? \
				<= Images $mol_row
					sub /
						<= Image_field*Avatar
						<= Image_field*Cover
		<= Access_section $mol_section
			title <= Access_title
			content /
				<= Account_label $mol_paragraph
					title <= Account_title
				<= Account_id $mol_button_copy
					title <= account_lord \
				<= Public $mol_view
					sub /
						<= Public_label $mol_paragraph
							title <= Public_title
						<= Public_text $mol_paragraph
							title <= Public_hint
						<= Public_link $mol_button_copy
							title <= public_link \
				<= Rights $giper_baza_land_rights
					land <= blog_land null
	Image_field* $mol_view
		sub <= image_rows* /
			<= Image_preview* $mol_view
				style <= image_preview_style* *
			<= Image_title* $mol_paragraph
				title <= image_title* \
			<= Image_actions* $mol_row
				sub <= image_actions_rows* /
					<= Image_pick* $mol_button_open
						multiple false
						accept \image/*
						hint <= Pick
						sub /
							<= Native* $mol_button_open_native
								files? <=> image_add*? /File
								accept \image/*
								multiple false
							<= Image_pick_icon* $mol_icon_image
							<= image_pick_text* \
					<= Image_drop* $mol_button_minor
						hint <= Cover_drop
						click? <=> image_drop*? null
						sub /
							<= image_drop_icon* $mol_icon_close
							<= image_drop_text* \

$bog_id_enter $mol_list
	provider \https://dev-cmyser.github.io/id/
	scope \account
	apply? \
	apply_fresh? \
	rows <= parts /
	Enter $mol_button_major
		title @ \Sign in with Giper ID
		click? <=> enter? null
	Hint $mol_paragraph
		title @ \Keeps the key of this account in Giper ID. Other devices get the same account. Nothing changes here until you confirm it.
	Status $mol_paragraph
		title <= status \
	Save $mol_button_major
		title @ \Save the current account there
		enabled <= idle true
		click? <=> save? null
	Fresh $mol_button_minor
		title <= fresh_title @ \Start a new account
		enabled <= idle
		click? <=> fresh? null
	Replace $mol_button_minor
		title <= replace_title @ \Switch to the account from Giper ID
		click? <=> replace? null
	Change $mol_button_minor
		title @ \Change Giper ID
		click? <=> enter?
	Error $mol_paragraph
		title <= error? \
	busy? false
	armed? \
	switch_sure @ \Really switch? The account changes in all apps of this domain
	wait @ \Getting the key from Giper Base…
	vacant_text @ \There is no account in this Giper ID yet: {name}
	conflict @ \Giper ID keeps another account: {name}. The account of this device stays until you switch.
	done @ \Signed in with Giper ID: {name}
	sending @ \Sending the key to Giper Base…
	error_bad @ \This does not look like an account key
	error_sent @ \The server has not confirmed the key. The account of this device is the same, try later

$bog_jj_app $mol_page
	title @ \Live Journal
	Feed_title @ \Feed
	Search_hint @ \Search posts
	Tag_title @ \Tag
	tag_current \
	plugins /
		<= Theme $bog_theme_auto
			themes /
				\$mol_theme_light
				\$mol_theme_dark
		<= Skin $bog_builderui_skin
			lights <= lights \system
			base \zinc
			font_head \eb-garamond
		<= Ico $bog_favicon
			Icon <= ico $mol_icon_rss
	head /
		<= Title
		<= Tools
	tools /
		<= Search $mol_search
			hint <= Search_hint
			query? <=> search? \
		<= Sync $giper_baza_status
		<= Lights $bog_theme_toggle
			theme_auto <= Theme
	body /
		<= Nav $mol_row
			sub <= nav_rows /
				<= Home_link $mol_link
					arg *
						blog null
						post null
						tag null
						settings null
						edit null
						search null
					title <= Feed_title
				<= Tag_label $mol_paragraph
					title <= tag_text \
				<= Account $mol_paragraph
					title <= account_text \
		<= Pages $mol_list
			rows <= pages /
				<= Blog* $bog_jj_blog
					blog_link <= blog_link* \
				<= Post* $bog_jj_post
					post_link <= post_link* \
					blog_link <= post_blog_link* \
				<= Feed $bog_jj_feed
					search <= search
					tag <= tag_current
				<= Settings* $bog_jj_settings
					blog_link <= settings_blog* \
		<= Id $bog_id_enter

$mol_embed_native $mol_scroll
	dom_name \iframe
	window null
	attr *
		^
		src <= uri? \about:config
	sub /
		<= Fallback $mol_link
			uri <= uri
			sub /
				<= title \
	message *
		hashchange? <=> uri_change? null

$mol_frame $mol_embed_native
	attr *
		tabindex <= tabindex
		allow <= allow \
		src <= uri
		srcdoc <= html null
	fullscreen true
	accelerometer true
	autoplay true
